{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Source Graph v1",
  "description": "Adapter contract for brain-galaxy data sources (docs/IMPORT.md)",
  "type": "object",
  "required": ["schema_version", "source", "nodes", "edges"],
  "properties": {
    "schema_version": { "const": 1 },
    "source": {
      "type": "object",
      "required": ["id", "name", "type"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$", "maxLength": 64 },
        "name": { "type": "string", "maxLength": 120 },
        "type": { "type": "string", "maxLength": 64 },
        "group_dimension": { "type": "string", "maxLength": 64 }
      }
    },
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label"],
        "properties": {
          "id": { "type": "string", "maxLength": 200 },
          "label": { "type": "string", "maxLength": 200 },
          "dimension": { "type": "string", "maxLength": 64 },
          "parent": { "type": "string", "maxLength": 200 }
        }
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label"],
        "properties": {
          "id": { "type": "string", "maxLength": 500 },
          "label": { "type": "string", "maxLength": 300 },
          "group": { "type": "string", "maxLength": 200 },
          "category": { "enum": ["note", "project", "topic", "person", "system", "message", "reference", "media"] },
          "importance": { "type": "number", "minimum": 0, "maximum": 1 },
          "origin": {
            "type": "object",
            "properties": {
              "uri": { "type": "string", "maxLength": 2000 },
              "device": { "type": "string", "maxLength": 120 },
              "retrievedAt": { "type": "string", "maxLength": 40 }
            }
          },
          "props": { "type": "object", "additionalProperties": true }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source", "target", "type"],
        "properties": {
          "source": { "type": "string", "maxLength": 500 },
          "target": { "type": "string", "maxLength": 500 },
          "type": { "type": "string", "maxLength": 64 },
          "weight": { "type": "number", "minimum": 0, "maximum": 10 }
        }
      }
    }
  }
}
